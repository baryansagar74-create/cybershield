{
  "manifest_version": 3,
  "name": "ProfileGuard Evidence Collector",
  "version": "1.0.0",
  "description": "Analyst-consented forensic capture of visible social media profiles for ITBP fake account detection.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://web.telegram.org/*"
  ],
  "icons": {
    "16": "icons/favicon_16.png",
    "32": "icons/favicon_32.png",
    "192": "icons/icon_192.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProfileGuard Capture",
    "default_icon": {
      "16": "icons/favicon_16.png",
      "32": "icons/favicon_32.png",
      "192": "icons/icon_192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://web.telegram.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
