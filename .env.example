# ==============================================================
# ProfileGuard - Environment Configuration
# ==============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env — it contains secrets.
# ==============================================================

# --- Project Settings (C1) ---
APP_ENV=                          # dev / staging / prod
APP_BASE_URL=                     # e.g. http://localhost:8000
DASHBOARD_URL=                    # e.g. http://localhost:3000
TIMEZONE=                         # e.g. Asia/Kolkata
ADMIN_EMAIL=                      # first analyst/admin e-mail
RISK_HIGH=0.80                    # score >= this -> HIGH band
RISK_MEDIUM=0.50                  # score >= this -> MEDIUM band
RETENTION_DAYS=                   # case-data retention in days

# --- Infrastructure (C2) ---
DATABASE_URL=                     # postgresql://user:password@host:5432/profileguard
REDIS_URL=                        # redis://host:6379/0
ELASTICSEARCH_URL=                # optional, e.g. http://localhost:9200
JWT_SECRET=                       # 32+ byte random string (generate, never display)
JWT_EXPIRY_MINUTES=30             # session length
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EVIDENCE_STORAGE_PATH=            # e.g. /data/evidence
VAULT_ADDR=                       # optional HashiCorp Vault
VAULT_TOKEN=                      # optional

# --- Meta: Facebook & Instagram (C3) ---
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_TOKEN=            # ~60-day expiry; track expiry date
META_GRAPH_VERSION=               # e.g. v19.0
IG_VIEWER_BUSINESS_ID=            # Instagram business account ID
META_PAGE_ID=                     # optional Facebook Page ID

# --- X / Twitter (C4) ---
X_BEARER_TOKEN=
X_API_KEY=                        # only if OAuth 1.0a
X_API_SECRET=                     # only if OAuth 1.0a
X_CLIENT_ID=                      # only if OAuth 2.0 PKCE
X_API_BASE=https://api.x.com/2
X_MONTHLY_CREDIT_BUDGET=          # spend cap in USD

# --- Telegram (C5) ---
TELEGRAM_BOT_TOKEN=               # from @BotFather
TELEGRAM_API_ID=                  # from https://my.telegram.org (MTProto only)
TELEGRAM_API_HASH=                # from https://my.telegram.org (MTProto only)

# --- Reputation & Image Services (C6) ---
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=   # path to Vision service-account JSON
TINEYE_API_KEY=                   # optional

# --- Blockchain Anchoring (C8, optional) ---
LEDGER_TYPE=                      # e.g. hyperledger_fabric
LEDGER_GATEWAY_URL=
LEDGER_CHANNEL=
LEDGER_CHAINCODE=
LEDGER_WALLET_PATH=
